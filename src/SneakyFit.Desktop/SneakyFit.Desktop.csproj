<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>SneakyFit</AssemblyName>
    <RootNamespace>SneakyFit.Desktop</RootNamespace>
    <Product>SneakyFit</Product>
    <Version>1.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/SneakyFit.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <SatelliteResourceLanguages>ru;en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ZXing.Net" Version="0.16.11" GeneratePathProperty="true" ExcludeAssets="runtime" />
    <EmbeddedResource Include="$(PkgZXing_Net)/lib/net9.0/zxing.dll" LogicalName="SneakyFit.Dependencies.zxing.dll" />
    <ProjectReference Include="../SneakyFit.Application/SneakyFit.Application.csproj" />
    <ProjectReference Include="../SneakyFit.Infrastructure/SneakyFit.Infrastructure.csproj" />
    <ProjectReference Include="../SneakyFit.Updates/SneakyFit.Updates.csproj" />
    <Resource Include="Assets/cat-dialog-frames.png" />
    <Resource Include="Assets/cat-emotions-a.png" />
    <Resource Include="Assets/cat-emotions-b.png" />
    <Resource Include="Assets/SneakyFit.ico" />
    <Resource Include="Assets/Fonts/*.ttf" />
    <Resource Include="Assets/Fonts/ShantellSans-OFL.txt" />
    <EmbeddedResource Include="Assets/Licenses/ThirdParty.txt" LogicalName="SneakyFit.Licenses.ThirdParty.txt" />
  </ItemGroup>
</Project>
